# Server-only. Never prefix this variable with NEXT_PUBLIC_.
BACKEND_URL=http://127.0.0.1:3000
# Canonical browser origin for admin CSRF checks; required for production.
WEB_ORIGIN=http://127.0.0.1:4000
# Safe default: preview is never indexed, even with NODE_ENV=production.
# After content/operations approval: public + a real HTTPS WEB_ORIGIN, then rebuild.
WEB_VISIBILITY=preview
