# PostgreSQL (docker compose up -d db → localhost:5433)
DATABASE_URL=postgresql://dosso:dosso@localhost:5433/dosso_dossi

# Web modülü varsayılan kapalıdır; mobil geliştirmeye yeni zorunlu ayar eklemez.
# docker compose --profile web up -d db-web → localhost:5444 (ayrı servis/kullanıcı).
WEB_ENABLED=false
WEB_DATABASE_URL=postgresql://dosso_web:dosso_web_local@localhost:5444/dosso_dossi_web
# Her backend süreci için sınırlı web bağlantı havuzu (1–20).
WEB_DATABASE_POOL_SIZE=5
# Web entegrasyon testleri bu ayrı *_test DB'yi kullanır; mobil test setup'ı çalışmaz.
WEB_TEST_DATABASE_URL=postgresql://dosso_web_test:dosso_web_test_local@localhost:5444/dosso_dossi_web_test

# Web müşteri doğrulama / şifre yenileme e-postaları (mobil SMS akışından ayrı).
# preview: sadece yerel geliştirme; .local/web-emails altında özel dosyalar.
# resend: gerçek gönderim; doğrulanmış gönderen ve API anahtarı gerektirir.
# Üretimde açıkça resend seçilmeli; varsayılan disabled, HTTPS origin zorunlu.
WEB_EMAIL_MODE=preview
WEB_PUBLIC_URL=http://127.0.0.1:4000
WEB_EMAIL_FROM=
RESEND_API_KEY=

# Web mağaza ödemesi mobilden tamamen ayrıdır. Yalnız iyzico sandbox desteklenir.
# Anahtarlar gelene kadar boş bırakın: sipariş açılır fakat ödeme başlatılmaz.
# Başka sağlayıcıya/üretime otomatik geçiş ve sahte başarılı ödeme yoktur.
WEB_PAYMENT_MODE=sandbox
WEB_IYZICO_API_KEY=
WEB_IYZICO_SECRET_KEY=
# Geçerli SSL ve dışarıdan erişim gerekir; localhost ile configured=false kalır.
# Son yol sabittir: https://API_ALAN_ADI/web/payments/iyzico/callback
WEB_IYZICO_CALLBACK_URL=
# Sandbox, iyzico örneklerindeki test identityNumber değerini kullanır.
# Gerçek TCKN toplanmaz; canlıya geçiş ayrıca tasarlanıp onaylanmalıdır.

# JWT — üretimde uzun rastgele bir değer kullanın (openssl rand -hex 32)
JWT_SECRET=degistir-bunu-gizli-bir-degerle
# Access token ömrü kısa tutulur; oturum refresh token'la sürer
JWT_EXPIRES_IN=15m

# POS köprüsü / ödeme sağlayıcı webhook HMAC sırları (ZORUNLU — sunucu
# bunlarsız açılmaz; para hareket ettiren uçları korurlar)
POS_WEBHOOK_SECRET=dev-pos-secret-degistir
PAYMENT_WEBHOOK_SECRET=dev-payment-secret-degistir

# Ödeme sağlayıcı: iyzico | dev (yalnız yerel simülasyon, gerçek tahsilat yok)
# Eksik iyzico ayarları uygulamayı kapatmaz; ödeme başlatma güvenle kapalı kalır.
# Dev seçimi açıkça yapılmalıdır. Üretimde dev sunucuyu başlatmaz.
PAYMENT_PROVIDER=iyzico
IYZICO_ENVIRONMENT=sandbox
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Geçerli HTTPS sertifikalı, iyzico tarafından ulaşılabilen backend callback'i:
IYZICO_CALLBACK_URL=
IYZICO_TIMEOUT_MS=10000
# Aktivasyon ve doğrulama adımları: ../docs/IYZICO.md

# Sunucu
PORT=3000
# Varsayılan: development=127.0.0.1, production=0.0.0.0.
# Fiziksel cihaz testi için ihtiyaç varsa HOST=0.0.0.0 verin.
# Reverse proxy varsa yalnız gerçek ingress IP/CIDR adreslerini yazın.
# Boşsa X-Forwarded-For güvenilmez. Örnek (topolojinize göre): 127.0.0.1,::1
# true, hop sayısı ve tüm interneti kapsayan /0 kabul edilmez.
TRUST_PROXY=
LOG_LEVEL=info
NODE_ENV=development

# ── Yalnızca geliştirme (üretimde true olursa sunucu AÇILMAZ) ──
# true iken OTP konsola yazılır ve 111111 her telefonda geçer
OTP_DEV_MODE=false
# true iken sipariş durumu zamanlayıcıyla otomatik ilerler (takip demosu)
POS_DEV_AUTOADVANCE=false

# ── Yönetim paneli ──
# Müşteri JWT_SECRET'ından FARKLI olmalı (aynıysa sunucu açılmaz):
# müşteri token'ının panele geçmesini engeller.
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=15m
# CORS yalnızca bu origin(ler)e açılır; virgülle ayrılır. Üretimde https zorunlu.
ADMIN_ORIGINS=http://localhost:5173
