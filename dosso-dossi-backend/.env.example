# PostgreSQL (docker compose up -d db → localhost:5433)
DATABASE_URL=postgresql://dosso:dosso@localhost:5433/dosso_dossi

# JWT — üretimde uzun rastgele bir değer kullanın (openssl rand -hex 32)
JWT_SECRET=degistir-bunu-gizli-bir-degerle
# Access token ömrü kısa tutulur; oturum refresh token'la sürer
JWT_EXPIRES_IN=15m

# POS köprüsü / ödeme sağlayıcı webhook HMAC sırları (ZORUNLU — sunucu
# bunlarsız açılmaz; para hareket ettiren uçları korurlar)
POS_WEBHOOK_SECRET=dev-pos-secret-degistir
PAYMENT_WEBHOOK_SECRET=dev-payment-secret-degistir

# Ödeme sağlayıcı: iyzico | dev (yalnız yerel simülasyon, gerçek tahsilat yok)
# Eksik iyzico ayarları uygulamayı kapatmaz; ödeme başlatma güvenle kapalı kalır.
# Dev seçimi açıkça yapılmalıdır. Üretimde dev sunucuyu başlatmaz.
PAYMENT_PROVIDER=iyzico
IYZICO_ENVIRONMENT=sandbox
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Geçerli HTTPS sertifikalı, iyzico tarafından ulaşılabilen backend callback'i:
IYZICO_CALLBACK_URL=
IYZICO_TIMEOUT_MS=10000
# Aktivasyon ve doğrulama adımları: ../docs/IYZICO.md

# Sunucu
PORT=3000
# Varsayılan: development=127.0.0.1, production=0.0.0.0.
# Fiziksel cihaz testi için ihtiyaç varsa HOST=0.0.0.0 verin.
# Reverse proxy varsa yalnız gerçek ingress IP/CIDR adreslerini yazın.
# Boşsa X-Forwarded-For güvenilmez. Örnek (topolojinize göre): 127.0.0.1,::1
# true, hop sayısı ve tüm interneti kapsayan /0 kabul edilmez.
TRUST_PROXY=
LOG_LEVEL=info
NODE_ENV=development

# ── Yalnızca geliştirme (üretimde true olursa sunucu AÇILMAZ) ──
# true iken OTP konsola yazılır ve 111111 her telefonda geçer
OTP_DEV_MODE=false
# true iken sipariş durumu zamanlayıcıyla otomatik ilerler (takip demosu)
POS_DEV_AUTOADVANCE=false

# ── Yönetim paneli ──
# Müşteri JWT_SECRET'ından FARKLI olmalı (aynıysa sunucu açılmaz):
# müşteri token'ının panele geçmesini engeller.
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=15m
# CORS yalnızca bu origin(ler)e açılır; virgülle ayrılır. Üretimde https zorunlu.
ADMIN_ORIGINS=http://localhost:5173
