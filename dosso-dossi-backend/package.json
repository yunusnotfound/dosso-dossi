{
  "name": "dosso-dossi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:web:integration": "vitest run --config vitest.web-integration.config.ts",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/web/schema.prisma",
    "prisma:web:migrate": "tsx scripts/web-prisma.ts deploy",
    "prisma:web:seed": "tsx scripts/web-prisma.ts seed",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx prisma/seed-admin.ts",
    "payment:check": "tsx scripts/check-payment-config.ts",
    "prisma:studio": "prisma studio",
    "extract:menu": "tsx scripts/extract-menu.ts",
    "optimize:images": "tsx scripts/optimize-images.ts",
    "pos:sim": "tsx scripts/pos-simulator.ts",
    "web:admin:create": "tsx scripts/web-admin-create.ts",
    "prisma:web:seed:catalog": "tsx prisma/web/seed-catalog.ts",
    "web:email:preview": "tsx scripts/web-email-preview.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^6.19.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
